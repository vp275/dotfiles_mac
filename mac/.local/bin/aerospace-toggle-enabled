#!/bin/sh

# Toggle the official AeroSpace app process.

LOG="$HOME/Library/Logs/aerospace-toggle-enabled.log"
AEROSPACE_APP="/Applications/AeroSpace.app"

if /usr/bin/pgrep -x AeroSpace >/dev/null 2>&1; then
  printf '%s killall AeroSpace\n' "$(/bin/date '+%Y-%m-%d %H:%M:%S')" >>"$LOG"
  /usr/bin/killall AeroSpace
  exit 0
fi

printf '%s open %s\n' "$(/bin/date '+%Y-%m-%d %H:%M:%S')" "$AEROSPACE_APP" >>"$LOG"
/usr/bin/open "$AEROSPACE_APP"
