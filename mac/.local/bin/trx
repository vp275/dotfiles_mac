#!/bin/zsh

emulate -L zsh
setopt NO_UNSET PIPE_FAIL

readonly TRX_NAME="trx"
readonly TRX_SUPPORT_DIR="${TRX_SUPPORT_DIR:-$HOME/Library/Application Support/trx}"
readonly TRX_STATE_FILE="${TRX_STATE_FILE:-$TRX_SUPPORT_DIR/active-provider}"
readonly TRX_BACKUP_DIR="${TRX_BACKUP_DIR:-$TRX_SUPPORT_DIR/backups}"
readonly TRX_LOG_FILE="${TRX_LOG_FILE:-$HOME/Library/Logs/trx.log}"
readonly TRX_LOCK_DIR="${TRX_LOCK_DIR:-${TMPDIR:-/tmp}/trx.lock}"

readonly BTT_TRACKPAD_UUID="CA4B9E78-76FB-4764-9301-A9937EE84D12"
readonly BTT_MAGIC_UUID="497F16E1-1725-4D6E-BD16-B8F88259EF2F"
readonly SPOKENLY_HELPER="$HOME/Applications/Spokenly Toggle.app"

readonly LOGI_DIR="$HOME/Library/Application Support/LogiOptionsPlus"
readonly LOGI_DB="${TRX_LOGI_DB:-$LOGI_DIR/settings.db}"
readonly LOGI_MACROS_DB="${TRX_LOGI_MACROS_DB:-$LOGI_DIR/macros.db}"
readonly LOGI_PLIST="/Library/LaunchAgents/com.logi.optionsplus.plist"
readonly LOGI_DOMAIN="gui/$(id -u)"
readonly LOGI_SERVICE="$LOGI_DOMAIN/com.logi.cp-dev-mgr"
readonly LOGI_SLOT="mx-master-3s-2b034_c195"
readonly LOGI_SMART_ACTION_ID="d18fe790-d754-4fbc-8e82-0e5df78bda9e"

readonly WISPR_CONFIG="$HOME/Library/Application Support/Wispr Flow/config.json"
readonly SPOKENLY_BUNDLE="app.spokenly"
readonly SPOKENLY_PROCESS="Spokenly"
readonly WISPR_BUNDLE="com.electron.wispr-flow"
readonly WISPR_PROCESS="Wispr Flow"

JQ_BIN="${TRX_JQ_BIN:-$(command -v jq 2>/dev/null || true)}"
SQLITE_BIN="${TRX_SQLITE_BIN:-$(command -v sqlite3 2>/dev/null || true)}"
transaction_dir=""
previous_state=""
previous_state_existed=0
previous_spokenly_running=0
previous_wispr_running=0
logi_is_stopped=0
transaction_active=0
spinner_pid=""
spinner_visible=0

usage() {
  cat <<'EOF'
Usage:
  trx spokenly
  trx wispr
  trx toggle
  trx status
  trx verify
  trx plan <spokenly|wispr>
  trx help

The explicit provider commands transactionally change the trackpad, MX Master,
and Magic Mouse hands-free mappings, then switch the running application.
EOF
}

log() {
  mkdir -p "${TRX_LOG_FILE:h}"
  printf '%s pid=%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$$" "$*" >>"$TRX_LOG_FILE"
}

spinner_start() {
  local message="$1"
  [[ -t 2 ]] || return 0

  (
    trap - EXIT INT TERM HUP
    local -a frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    local frame=1
    local ticks=0

    while true; do
      printf '\r\033[36m%s\033[0m %s, %ds' \
        "$frames[$frame]" "$message" "$(( ticks / 10 ))" >&2
      sleep 0.1
      (( frame = frame % ${#frames} + 1 ))
      (( ticks += 1 ))
    done
  ) &
  spinner_pid=$!
  spinner_visible=1
}

spinner_stop() {
  if [[ -n "$spinner_pid" ]]; then
    kill "$spinner_pid" 2>/dev/null || true
    wait "$spinner_pid" 2>/dev/null || true
    spinner_pid=""
  fi
  if (( spinner_visible == 1 )); then
    printf '\r\033[2K' >&2
    spinner_visible=0
  fi
}

die() {
  spinner_stop
  log "error $*"
  printf '%s: %s\n' "$TRX_NAME" "$*" >&2
  return 1
}

notify() {
  local message="$1"
  /usr/bin/osascript - "$message" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  display notification (item 1 of argv) with title "trx"
end run
APPLESCRIPT
}

require_dependencies() {
  [[ -n "$JQ_BIN" && -x "$JQ_BIN" ]] || {
    die "jq is required"
    return 1
  }
  [[ -n "$SQLITE_BIN" && -x "$SQLITE_BIN" ]] || {
    die "sqlite3 is required"
    return 1
  }
  [[ -x /usr/bin/osascript ]] || {
    die "osascript is required"
    return 1
  }
  [[ -x /bin/launchctl ]] || {
    die "launchctl is required"
    return 1
  }
  [[ -f "$LOGI_DB" ]] || {
    die "Logitech settings database not found: $LOGI_DB"
    return 1
  }
  [[ -f "$LOGI_MACROS_DB" ]] || {
    die "Logitech macros database not found: $LOGI_MACROS_DB"
    return 1
  }
  [[ -f "$WISPR_CONFIG" ]] || {
    die "Wispr Flow configuration not found: $WISPR_CONFIG"
    return 1
  }
}

normalize_provider() {
  case "${1:-}" in
    spokenly)
      printf 'spokenly\n'
      ;;
    wispr|wispr-flow)
      printf 'wispr\n'
      ;;
    *)
      return 1
      ;;
  esac
}

provider_label() {
  case "$1" in
    spokenly) printf 'Spokenly\n' ;;
    wispr) printf 'Wispr Flow\n' ;;
  esac
}

acquire_lock() {
  if ! mkdir "$TRX_LOCK_DIR" 2>/dev/null; then
    die "another switch is already running"
    return 1
  fi
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM
  spinner_stop

  if (( transaction_active == 1 )) && [[ -n "$transaction_dir" ]]; then
    log "cleanup-rollback exit=$exit_code"
    recover_transaction "Switch interrupted" || true
  elif (( logi_is_stopped == 1 )); then
    log "cleanup-restart-logitech exit=$exit_code"
    logi_start >/dev/null 2>&1 || true
  fi

  rmdir "$TRX_LOCK_DIR" 2>/dev/null || true
  return "$exit_code"
}

app_running() {
  local provider="$1"
  case "$provider" in
    spokenly)
      /usr/bin/pgrep -x "$SPOKENLY_PROCESS" >/dev/null 2>&1
      ;;
    wispr)
      /usr/bin/pgrep -x "$WISPR_PROCESS" >/dev/null 2>&1
      ;;
  esac
}

app_bundle() {
  case "$1" in
    spokenly) printf '%s\n' "$SPOKENLY_BUNDLE" ;;
    wispr) printf '%s\n' "$WISPR_BUNDLE" ;;
  esac
}

wait_for_app_state() {
  local provider="$1"
  local expected="$2"
  local attempts=0

  while (( attempts < 100 )); do
    if app_running "$provider"; then
      [[ "$expected" == "running" ]] && return 0
    else
      [[ "$expected" == "stopped" ]] && return 0
    fi
    sleep 0.1
    (( attempts += 1 ))
  done
  return 1
}

stop_app() {
  local provider="$1"
  local bundle
  bundle="$(app_bundle "$provider")"

  app_running "$provider" || return 0
  log "stopping-app provider=$provider bundle=$bundle"
  /usr/bin/osascript - "$bundle" <<'APPLESCRIPT' >/dev/null 2>&1 || return 1
on run argv
  tell application id (item 1 of argv) to quit
end run
APPLESCRIPT
  wait_for_app_state "$provider" stopped
}

start_app() {
  local provider="$1"
  local bundle
  bundle="$(app_bundle "$provider")"

  app_running "$provider" && return 0
  log "starting-app provider=$provider bundle=$bundle"
  /usr/bin/open -g -b "$bundle" >/dev/null 2>&1 || return 1
  wait_for_app_state "$provider" running
}

apply_app_state() {
  local target="$1"
  local other
  [[ "$target" == "spokenly" ]] && other="wispr" || other="spokenly"

  stop_app "$other" || return 1
  start_app "$target" || return 1
  app_running "$target" || return 1
  ! app_running "$other"
}

btt_get_trigger() {
  local uuid="$1"
  /usr/bin/osascript - "$uuid" <<'APPLESCRIPT'
on run argv
  tell application "BetterTouchTool"
    return get_triggers trigger_uuid (item 1 of argv)
  end tell
end run
APPLESCRIPT
}

btt_trigger_json() {
  local provider="$1"
  local device="$2"
  local uuid trigger_type trigger_class description notes order action_uuid

  case "$device" in
    trackpad)
      uuid="$BTT_TRACKPAD_UUID"
      trigger_type=104
      trigger_class="BTTTriggerTypeTouchpadAll"
      order=2
      action_uuid="B676F40D-4709-4F32-BB12-271827448EAB"
      if [[ "$provider" == "spokenly" ]]; then
        description="3 Finger Tap - Spokenly hands-free toggle via Spokenly Toggle.app"
      else
        description="3 Finger Tap - Wispr hands-free (Right Option)"
      fi
      notes="$description"
      ;;
    magic)
      uuid="$BTT_MAGIC_UUID"
      trigger_type=16
      trigger_class="BTTTriggerTypeMagicMouse"
      order=1
      action_uuid="B78BFD97-6D98-496B-8D15-42B6701235FF"
      if [[ "$provider" == "spokenly" ]]; then
        description="TipTap Left (1 Finger Fix) - Spokenly hands-free toggle via Spokenly Toggle.app"
        notes="Magic Mouse: TipTap Left (1 Finger Fix) opens Spokenly Toggle.app for hands-free dictation."
      else
        description="TipTap Left (1 Finger Fix) - Wispr hands-free (Right Option)"
        notes="Magic Mouse: TipTap Left (1 Finger Fix) sends right Option for Wispr Flow hands-free."
      fi
      ;;
    *)
      return 1
      ;;
  esac

  if [[ "$provider" == "spokenly" ]]; then
    "$JQ_BIN" -cn \
      --arg uuid "$uuid" \
      --arg class "$trigger_class" \
      --arg description "$description" \
      --arg notes "$notes" \
      --arg path "$SPOKENLY_HELPER" \
      --arg action_uuid "$action_uuid" \
      --argjson type "$trigger_type" \
      --argjson order "$order" \
      '{
        BTTTriggerType: $type,
        BTTTriggerClass: $class,
        BTTUUID: $uuid,
        BTTTriggerBelongsToPreset: "Default",
        BTTBelongsToApp: "Global",
        BTTTriggerTypeDescription: $description,
        BTTEnabled: 1,
        BTTEnabled2: 1,
        BTTOrder: $order,
        BTTGestureNotes: $description,
        BTTNotes: $notes,
        BTTActionsToExecute: [{
          BTTUUID: $action_uuid,
          BTTTriggerBelongsToPreset: "Default",
          BTTTriggerParentUUID: $uuid,
          BTTIsPureAction: true,
          BTTPredefinedActionType: 49,
          BTTLaunchPath: $path,
          BTTOrder: 0
        }]
      }'
  else
    "$JQ_BIN" -cn \
      --arg uuid "$uuid" \
      --arg class "$trigger_class" \
      --arg description "$description" \
      --arg notes "$notes" \
      --argjson type "$trigger_type" \
      --argjson order "$order" \
      '{
        BTTTriggerType: $type,
        BTTTriggerClass: $class,
        BTTUUID: $uuid,
        BTTTriggerBelongsToPreset: "Default",
        BTTBelongsToApp: "Global",
        BTTTriggerTypeDescription: $description,
        BTTEnabled: 1,
        BTTEnabled2: 1,
        BTTOrder: $order,
        BTTGestureNotes: $description,
        BTTNotes: $notes,
        BTTShortcutToSend: "61"
      }'
  fi
}

btt_replace_trigger() {
  local uuid="$1"
  local trigger_json="$2"

  /usr/bin/osascript - "$uuid" "$trigger_json" <<'APPLESCRIPT' >/dev/null || return 1
on run argv
  set triggerUUID to item 1 of argv
  set triggerJSON to item 2 of argv
  tell application "BetterTouchTool"
    try
      delete_trigger triggerUUID
    end try
    return add_new_trigger triggerJSON
  end tell
end run
APPLESCRIPT

  /usr/bin/osascript - "$uuid" <<'APPLESCRIPT' >/dev/null || return 1
on run argv
  tell application "BetterTouchTool"
    update_trigger (item 1 of argv) json "{\"BTTEnabled\":0}"
  end tell
end run
APPLESCRIPT
  sleep 0.15
  /usr/bin/osascript - "$uuid" <<'APPLESCRIPT' >/dev/null || return 1
on run argv
  tell application "BetterTouchTool"
    update_trigger (item 1 of argv) json "{\"BTTEnabled\":1}"
  end tell
end run
APPLESCRIPT
  sleep 0.15
}

btt_apply_provider() {
  local provider="$1"
  local trackpad_json magic_json
  trackpad_json="$(btt_trigger_json "$provider" trackpad)" || return 1
  magic_json="$(btt_trigger_json "$provider" magic)" || return 1

  log "applying-btt provider=$provider trigger=$BTT_TRACKPAD_UUID"
  btt_replace_trigger "$BTT_TRACKPAD_UUID" "$trackpad_json" || return 1
  log "applying-btt provider=$provider trigger=$BTT_MAGIC_UUID"
  btt_replace_trigger "$BTT_MAGIC_UUID" "$magic_json" || return 1
}

btt_trigger_provider() {
  local uuid="$1"
  local json
  json="$(btt_get_trigger "$uuid" 2>/dev/null)" || {
    printf 'unknown\n'
    return 0
  }

  "$JQ_BIN" -r --arg helper "$SPOKENLY_HELPER" '
    if length != 1 or ((.[0].BTTEnabled // 1) == 0) then "unknown"
    elif .[0].BTTShortcutToSend == "61" and ((.[0].BTTActionsToExecute // []) | length) == 0 then "wispr"
    elif (.[0].BTTShortcutToSend == null)
      and ((.[0].BTTActionsToExecute // []) | length) == 1
      and .[0].BTTActionsToExecute[0].BTTPredefinedActionType == 49
      and .[0].BTTActionsToExecute[0].BTTLaunchPath == $helper then "spokenly"
    else "unknown"
    end
  ' <<<"$json"
}

btt_detect_provider() {
  local trackpad magic
  trackpad="$(btt_trigger_provider "$BTT_TRACKPAD_UUID")"
  magic="$(btt_trigger_provider "$BTT_MAGIC_UUID")"
  if [[ "$trackpad" == "$magic" && "$trackpad" != "unknown" ]]; then
    printf '%s\n' "$trackpad"
  else
    printf 'mixed\n'
  fi
}

logi_root_json() {
  "$SQLITE_BIN" -json "$LOGI_DB" \
    'select cast(file as text) as file from data order by _id limit 1' \
    | "$JQ_BIN" -er '.[0].file | fromjson'
}

logi_assignment_json() {
  local provider="$1"
  if [[ "$provider" == "spokenly" ]]; then
    "$JQ_BIN" -cn \
      --arg slot "$LOGI_SLOT" \
      --arg id "$LOGI_SMART_ACTION_ID" \
      '{
        card: {
          attribute: "MACRO_REF",
          id: $id,
          name: "Spokenly Hands-Free"
        },
        cardId: $id,
        slotId: $slot,
        tags: ["UI_PAGE_BUTTONS"]
      }'
  else
    "$JQ_BIN" -cn \
      --arg slot "$LOGI_SLOT" \
      '{
        card: {
          attribute: "MACRO_PLAYBACK",
          icons: {
            icons: ["Shortcut.png", "Shortcut.svg"],
            uri: "pipeline://system_actions/"
          },
          id: "card_global_presets_keyboard_shortcut",
          macro: {
            actionName: "keyboard_none",
            keystroke: {
              code: 230,
              displayCharacter: "⌥ Opt →",
              virtualKeyId: "VK_RMENU"
            },
            type: "KEYSTROKE"
          },
          name: "ASSIGNMENT_NAME_KEYBOARD_SHORTCUT",
          tags: [
            "PRESET_TAG_KEY_OR_BUTTON",
            "PRESET_TAG_MACROS_UNSUPPORTED",
            "PRESET_KEYBOARD_FUNCTIONS"
          ],
          taskId: 73
        },
        cardId: "card_global_presets_keyboard_shortcut",
        slotId: $slot,
        tags: ["UI_PAGE_BUTTONS"]
      }'
  fi
}

logi_detect_provider() {
  local root
  root="$(logi_root_json 2>/dev/null)" || {
    printf 'unknown\n'
    return 0
  }

  "$JQ_BIN" -r \
    --arg slot "$LOGI_SLOT" \
    --arg smart "$LOGI_SMART_ACTION_ID" '
      def assignment($p):
        [.[$p].assignments[]? | select(.slotId == $slot)];
      def style($a):
        if ($a.card.attribute == "MACRO_REF"
          and $a.card.id == $smart
          and $a.cardId == $smart) then "spokenly"
        elif ($a.card.attribute == "MACRO_PLAYBACK"
          and $a.cardId == "card_global_presets_keyboard_shortcut"
          and $a.card.macro.keystroke.code == 230
          and $a.card.macro.keystroke.virtualKeyId == "VK_RMENU") then "wispr"
        else "unknown"
        end;
      (.profile_keys // []) as $profiles
      | [$profiles[] as $p | assignment($p)] as $sets
      | if ($sets | length > 0) and ($sets | all(length == 1)) then
          ($sets | map(style(.[0]))) as $styles
          | if ($styles | all(. == "spokenly")) then "spokenly"
            elif ($styles | all(. == "wispr")) then "wispr"
            else "mixed"
            end
        else "mixed"
        end
    ' <<<"$root"
}

logi_agent_running() {
  /bin/launchctl print "$LOGI_SERVICE" >/dev/null 2>&1
}

wait_for_logi_state() {
  local expected="$1"
  local attempts=0
  while (( attempts < 100 )); do
    if logi_agent_running; then
      [[ "$expected" == "running" ]] && return 0
    else
      [[ "$expected" == "stopped" ]] && return 0
    fi
    sleep 0.1
    (( attempts += 1 ))
  done
  return 1
}

logi_stop() {
  if ! logi_agent_running; then
    logi_is_stopped=1
    return 0
  fi

  log "stopping-logitech service=$LOGI_SERVICE"
  /bin/launchctl bootout "$LOGI_SERVICE" >/dev/null 2>&1 || return 1
  wait_for_logi_state stopped || return 1
  logi_is_stopped=1
  "$SQLITE_BIN" -bail "$LOGI_DB" 'PRAGMA wal_checkpoint(TRUNCATE);' >/dev/null || return 1
}

logi_start() {
  if logi_agent_running; then
    logi_is_stopped=0
    return 0
  fi

  log "starting-logitech plist=$LOGI_PLIST"
  /bin/launchctl bootstrap "$LOGI_DOMAIN" "$LOGI_PLIST" >/dev/null 2>&1 || return 1
  wait_for_logi_state running || return 1
  logi_is_stopped=0
  sleep 1
}

logi_patch_provider() {
  local provider="$1"
  local root_file="$transaction_dir/logi-root.json"
  local patched_file="$transaction_dir/logi-root-$provider.json"
  local assignment
  assignment="$(logi_assignment_json "$provider")" || return 1

  logi_root_json >"$root_file" || return 1
  "$JQ_BIN" -e \
    --arg slot "$LOGI_SLOT" \
    --argjson replacement "$assignment" '
      def count_slot($p): [.[$p].assignments[]? | select(.slotId == $slot)] | length;
      (.profile_keys // []) as $profiles
      | if ($profiles | length == 0)
          or ([$profiles[] as $p | count_slot($p)] | any(. != 1)) then
        error("expected exactly one c195 assignment in every Logitech profile")
      else
        reduce $profiles[] as $p (.;
          .[$p].assignments |= map(if .slotId == $slot then $replacement else . end)
        )
      end
    ' "$root_file" >"$patched_file" || return 1

  "$JQ_BIN" -e . "$patched_file" >/dev/null || return 1
  "$SQLITE_BIN" -bail "$LOGI_DB" <<SQL >/dev/null || return 1
PRAGMA busy_timeout=5000;
BEGIN IMMEDIATE;
UPDATE data SET file=readfile('$patched_file') WHERE _id=(SELECT MIN(_id) FROM data);
COMMIT;
PRAGMA wal_checkpoint(TRUNCATE);
PRAGMA quick_check;
SQL
}

logi_apply_provider() {
  local provider="$1"
  logi_stop || return 1
  log "applying-logitech provider=$provider scope=all-profiles"
  logi_patch_provider "$provider" || return 1
  logi_start || return 1
  [[ "$(logi_detect_provider)" == "$provider" ]]
}

smart_action_valid() {
  "$SQLITE_BIN" -json "$LOGI_MACROS_DB" \
    'select cast(file as text) as file from data order by _id limit 1' \
    | "$JQ_BIN" -e \
      --arg id "$LOGI_SMART_ACTION_ID" \
      --arg helper "$SPOKENLY_HELPER" '
        .[0].file | fromjson
        | [.. | objects | select(.id? == $id)
          | select(any(.cards[]?;
              .macro.type == "OPEN_FILE_FOLDER"
              and .macro.openFileFolder.path == $helper))]
        | length == 1
      ' >/dev/null
}

wispr_shortcut_valid() {
  "$JQ_BIN" -e '.prefs.user.shortcuts["61"] == "popo"' "$WISPR_CONFIG" >/dev/null
}

preflight() {
  require_dependencies || return 1
  [[ -d "$SPOKENLY_HELPER" ]] || {
    die "Spokenly helper not found: $SPOKENLY_HELPER"
    return 1
  }
  [[ -d /Applications/Spokenly.app ]] || {
    die "Spokenly is not installed"
    return 1
  }
  [[ -d '/Applications/Wispr Flow.app' ]] || {
    die "Wispr Flow is not installed"
    return 1
  }
  wispr_shortcut_valid || {
    die "Wispr Flow shortcut 61 is not mapped to popo"
    return 1
  }
  smart_action_valid || {
    die "Spokenly Logitech Smart Action is missing or invalid"
    return 1
  }
  [[ "$(btt_trigger_provider "$BTT_TRACKPAD_UUID")" != "unknown" ]] || {
    die "trackpad BTT trigger is missing or invalid"
    return 1
  }
  [[ "$(btt_trigger_provider "$BTT_MAGIC_UUID")" != "unknown" ]] || {
    die "Magic Mouse BTT trigger is missing or invalid"
    return 1
  }
  [[ "$(logi_detect_provider)" != "unknown" ]] || {
    die "Logitech mappings could not be read"
    return 1
  }
  [[ "$($SQLITE_BIN -readonly "$LOGI_DB" 'PRAGMA quick_check;' 2>/dev/null)" == "ok" ]] || {
    die "Logitech settings database failed quick_check"
    return 1
  }
  [[ "$($SQLITE_BIN -readonly "$LOGI_MACROS_DB" 'PRAGMA quick_check;' 2>/dev/null)" == "ok" ]] || {
    die "Logitech macros database failed quick_check"
    return 1
  }
}

detect_provider() {
  local btt logi
  btt="$(btt_detect_provider)"
  logi="$(logi_detect_provider)"
  if [[ "$btt" == "$logi" && "$btt" != "mixed" && "$btt" != "unknown" ]]; then
    printf '%s\n' "$btt"
  else
    printf 'mixed\n'
  fi
}

verify_provider() {
  local provider="$1"
  [[ "$(btt_trigger_provider "$BTT_TRACKPAD_UUID")" == "$provider" ]] || return 1
  [[ "$(btt_trigger_provider "$BTT_MAGIC_UUID")" == "$provider" ]] || return 1
  [[ "$(logi_detect_provider)" == "$provider" ]] || return 1
  wispr_shortcut_valid || return 1
  [[ "$($SQLITE_BIN -readonly "$LOGI_DB" 'PRAGMA quick_check;' 2>/dev/null)" == "ok" ]] || return 1
  if [[ "$provider" == "spokenly" ]]; then
    smart_action_valid || return 1
  fi
}

save_transaction_snapshot() {
  local timestamp
  timestamp="$(date '+%Y%m%d-%H%M%S')"
  transaction_dir="$TRX_BACKUP_DIR/$timestamp-$$"
  mkdir -p "$transaction_dir" || return 1

  btt_get_trigger "$BTT_TRACKPAD_UUID" >"$transaction_dir/btt-trackpad.json" || return 1
  btt_get_trigger "$BTT_MAGIC_UUID" >"$transaction_dir/btt-magic.json" || return 1
  "$SQLITE_BIN" -bail "$LOGI_DB" ".backup '$transaction_dir/logi-settings.db'" || return 1
  [[ "$($SQLITE_BIN -readonly "$transaction_dir/logi-settings.db" 'PRAGMA quick_check;' 2>/dev/null)" == "ok" ]] || return 1

  if [[ -f "$TRX_STATE_FILE" ]]; then
    previous_state_existed=1
    previous_state="$(<"$TRX_STATE_FILE")"
    printf '%s\n' "$previous_state" >"$transaction_dir/previous-state"
  else
    previous_state_existed=0
  fi

  app_running spokenly && previous_spokenly_running=1 || previous_spokenly_running=0
  app_running wispr && previous_wispr_running=1 || previous_wispr_running=0
  printf 'spokenly=%s\nwispr=%s\n' "$previous_spokenly_running" "$previous_wispr_running" >"$transaction_dir/previous-apps"
  log "snapshot-created dir=$transaction_dir"
}

restore_btt_snapshot() {
  local uuid="$1"
  local file="$2"
  local json
  json="$($JQ_BIN -ce 'if length == 1 then .[0] else error("invalid BTT snapshot") end' "$file")" || return 1
  btt_replace_trigger "$uuid" "$json"
}

restore_logi_snapshot() {
  [[ -f "$transaction_dir/logi-settings.db" ]] || return 1
  logi_stop || return 1
  "$SQLITE_BIN" -bail "$transaction_dir/logi-settings.db" ".backup '$LOGI_DB'" || return 1
  "$SQLITE_BIN" -bail "$LOGI_DB" 'PRAGMA wal_checkpoint(TRUNCATE); PRAGMA quick_check;' >/dev/null || return 1
  logi_start
}

restore_app_snapshot() {
  local failed=0
  stop_app spokenly >/dev/null 2>&1 || failed=1
  stop_app wispr >/dev/null 2>&1 || failed=1
  if (( previous_spokenly_running == 1 )); then
    start_app spokenly >/dev/null 2>&1 || failed=1
  fi
  if (( previous_wispr_running == 1 )); then
    start_app wispr >/dev/null 2>&1 || failed=1
  fi
  return "$failed"
}

restore_state_snapshot() {
  if (( previous_state_existed == 1 )); then
    mkdir -p "${TRX_STATE_FILE:h}" || return 1
    printf '%s\n' "$previous_state" >"$TRX_STATE_FILE" || return 1
  else
    rm -f "$TRX_STATE_FILE" || return 1
  fi
}

rollback_transaction() {
  local failed=0
  [[ -n "$transaction_dir" ]] || return 0
  log "rollback-start dir=$transaction_dir"

  restore_btt_snapshot "$BTT_TRACKPAD_UUID" "$transaction_dir/btt-trackpad.json" || failed=1
  restore_btt_snapshot "$BTT_MAGIC_UUID" "$transaction_dir/btt-magic.json" || failed=1
  restore_logi_snapshot || failed=1
  restore_app_snapshot || failed=1
  restore_state_snapshot || failed=1

  if (( failed == 1 )); then
    log "rollback-incomplete dir=$transaction_dir"
    transaction_active=1
    return 1
  fi
  log "rollback-complete dir=$transaction_dir"
  transaction_active=0
}

recover_transaction() {
  local context="$1"
  if rollback_transaction; then
    notify "$context; previous setup restored"
  elif rollback_transaction; then
    log "rollback-complete-after-retry dir=$transaction_dir"
    notify "$context; previous setup restored after retry"
  else
    transaction_active=0
    (( logi_is_stopped == 1 )) && logi_start >/dev/null 2>&1 || true
    log "manual-recovery-required dir=$transaction_dir"
    notify "$context; manual recovery may be required"
    printf 'trx: rollback failed. Recovery backup: %s\n' "$transaction_dir" >&2
    return 1
  fi
}

fail_switch() {
  local message="$1"
  die "$message" || true
  recover_transaction "Switch failed" || true
  return 1
}

write_state() {
  local provider="$1"
  local temp_file
  mkdir -p "${TRX_STATE_FILE:h}" || return 1
  temp_file="$(mktemp "${TRX_STATE_FILE:h}/active-provider.XXXXXX")" || return 1
  printf '%s\n' "$provider" >"$temp_file" || return 1
  mv "$temp_file" "$TRX_STATE_FILE"
}

switch_provider() {
  local target="$1"
  local current

  acquire_lock || return 1
  spinner_start "Switching inputs to $(provider_label "$target")"
  preflight || return 1
  current="$(detect_provider)"

  save_transaction_snapshot || {
    die "could not create a rollback snapshot"
    return 1
  }
  transaction_active=1

  if [[ "$current" == "$target" ]]; then
    log "already-selected provider=$target"
    if ! apply_app_state "$target"; then
      fail_switch "mappings already select $target, but application switching failed"
      return 1
    fi
    if ! write_state "$target"; then
      fail_switch "could not record active provider"
      return 1
    fi
    transaction_active=0
    spinner_stop
    notify "Using $target"
    printf 'Already configured for %s; application state verified. Backup: %s\n' "$target" "$transaction_dir"
    return 0
  fi

  log "switch-start from=$current to=$target"
  if ! btt_apply_provider "$target"; then
    fail_switch "BTT profile application failed"
    return 1
  fi
  if ! logi_apply_provider "$target"; then
    logi_is_stopped=1
    fail_switch "Logitech profile application failed"
    return 1
  fi
  if ! verify_provider "$target"; then
    fail_switch "mapping verification failed"
    return 1
  fi
  if ! apply_app_state "$target"; then
    fail_switch "application switching failed"
    return 1
  fi
  if ! verify_provider "$target"; then
    fail_switch "post-launch mapping verification failed"
    return 1
  fi
  if ! write_state "$target"; then
    fail_switch "could not record active provider"
    return 1
  fi

  transaction_active=0
  log "switch-complete provider=$target backup=$transaction_dir"
  spinner_stop
  notify "Using $target"
  printf 'Switched to %s. Backup: %s\n' "$target" "$transaction_dir"
}

show_status() {
  local saved="unset"
  local trackpad magic logi detected spokenly_state wispr_state
  [[ -f "$TRX_STATE_FILE" ]] && saved="$(<"$TRX_STATE_FILE")"
  trackpad="$(btt_trigger_provider "$BTT_TRACKPAD_UUID")"
  magic="$(btt_trigger_provider "$BTT_MAGIC_UUID")"
  logi="$(logi_detect_provider)"
  detected="$(detect_provider)"
  app_running spokenly && spokenly_state="running" || spokenly_state="stopped"
  app_running wispr && wispr_state="running" || wispr_state="stopped"

  printf '%-18s %s\n' "Saved provider:" "$saved"
  printf '%-18s %s\n' "Detected mappings:" "$detected"
  printf '%-18s %s\n' "Trackpad BTT:" "$trackpad"
  printf '%-18s %s\n' "Magic Mouse BTT:" "$magic"
  printf '%-18s %s\n' "MX Master Logi:" "$logi"
  printf '%-18s %s\n' "Spokenly app:" "$spokenly_state"
  printf '%-18s %s\n' "Wispr Flow app:" "$wispr_state"
}

verify_current() {
  local detected
  detected="$(detect_provider)"
  [[ "$detected" != "mixed" ]] || {
    die "device mappings are mixed or unknown"
    return 1
  }
  verify_provider "$detected" || {
    die "mapping verification failed for $detected"
    return 1
  }
  if [[ "$detected" == "spokenly" ]]; then
    app_running spokenly || {
      die "Spokenly mappings are selected but Spokenly is not running"
      return 1
    }
    ! app_running wispr || {
      die "both providers are running"
      return 1
    }
  else
    app_running wispr || {
      die "Wispr mappings are selected but Wispr Flow is not running"
      return 1
    }
    ! app_running spokenly || {
      die "both providers are running"
      return 1
    }
  fi
  printf 'Verified %s mappings and application state.\n' "$detected"
}

show_plan() {
  local target="$1"
  printf 'Target: %s\n' "$target"
  if [[ "$target" == "spokenly" ]]; then
    printf '%s\n' \
      "Trackpad: launch $SPOKENLY_HELPER" \
      "Magic Mouse: launch $SPOKENLY_HELPER" \
      "MX Master: Smart Action $LOGI_SMART_ACTION_ID" \
      "Apps: stop Wispr Flow, start Spokenly"
  else
    printf '%s\n' \
      "Trackpad: send Right Option, BTT code 61" \
      "Magic Mouse: send Right Option, BTT code 61" \
      "MX Master: send Right Option, Logitech HID code 230" \
      "Apps: stop Spokenly, start Wispr Flow"
  fi
}

main() {
  local command="${1:-help}"
  local target current

  case "$command" in
    help|-h|--help)
      usage
      ;;
    status)
      require_dependencies || return 1
      show_status
      ;;
    verify)
      require_dependencies || return 1
      verify_current
      ;;
    plan)
      target="$(normalize_provider "${2:-}")" || {
        usage >&2
        return 64
      }
      show_plan "$target"
      ;;
    toggle)
      require_dependencies || return 1
      current="$(detect_provider)"
      case "$current" in
        spokenly) target="wispr" ;;
        wispr) target="spokenly" ;;
        *)
          die "cannot toggle mixed or unknown mappings; choose trx spokenly or trx wispr"
          return 1
          ;;
      esac
      switch_provider "$target"
      ;;
    spokenly|wispr|wispr-flow)
      target="$(normalize_provider "$command")" || return 64
      switch_provider "$target"
      ;;
    *)
      usage >&2
      return 64
      ;;
  esac
}

main "$@"
