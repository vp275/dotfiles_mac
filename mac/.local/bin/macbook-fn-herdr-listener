#!/bin/sh

set -eu

source_path="$HOME/.dotfiles/mac/.local/bin/macbook-fn-herdr-listener.swift"
binary_path="$HOME/Library/Caches/dotfiles/macbook-fn-herdr-listener"
module_cache_path="$HOME/Library/Caches/dotfiles/swift-module-cache"
temporary_path="${binary_path}.tmp.$$"

mkdir -p "$(dirname "$binary_path")" "$module_cache_path"

if [ ! -x "$binary_path" ] || [ "$source_path" -nt "$binary_path" ]; then
  trap 'rm -f "$temporary_path"' EXIT HUP INT TERM
  /usr/bin/swiftc -module-cache-path "$module_cache_path" "$source_path" -o "$temporary_path"
  /usr/bin/codesign --force --sign - --identifier com.vp.macbook-fn-herdr-listener "$temporary_path"
  mv "$temporary_path" "$binary_path"
  trap - EXIT HUP INT TERM
fi

exec "$binary_path"
